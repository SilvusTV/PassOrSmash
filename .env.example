# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Identifiant du flux Web GA4, au format G-XXXXXXXXXX. Sans lui, aucune balise n'est chargée.
VITE_GOOGLE_ANALYTICS_ID=

# Studio éditorial : liste explicite d'identifiants Discord administrateurs, séparés par des virgules.
EDITORIAL_ADMIN_DISCORD_IDS=
# Vides = OAuth intégré avec la session Discord. Issuer/JWKS sont découverts automatiquement.
# À renseigner seulement pour utiliser un fournisseur OAuth externe à la place.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# Origines exactes autorisées pour les clients MCP dans un navigateur (séparées par des virgules).
MCP_ALLOWED_ORIGINS=
# Adaptateurs HTTPS : voir docs/mcp-editorial-mise-en-service.md pour les contrats JSON.
EDITORIAL_GENERATION_URL=
EDITORIAL_GENERATION_TOKEN=
EDITORIAL_NOTIFICATION_URL=
EDITORIAL_NOTIFICATION_TOKEN=

# Session
SESSION_DRIVER=cookie

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=passorsmash
DB_PASSWORD=passorsmash-local-secret
DB_DATABASE=passorsmash

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3333/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=passorsmash
AWS_SECRET_ACCESS_KEY=passorsmash-local-secret
AWS_REGION=us-east-1
S3_BUCKET=passorsmash-images
S_3_ENDPOINT=http://localhost:9000
S_3_FORCE_PATH_STYLE=true
